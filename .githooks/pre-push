#!/bin/bash
# Runs the tests before every push. Turn on once per clone with:
#   git config core.hooksPath .githooks
# Skip in an emergency with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "FocusFlow: Tests laufen vor dem Push …"
if ! scripts/test.sh >/tmp/focusflow-pre-push.log 2>&1; then
    grep -E "✘|error:" /tmp/focusflow-pre-push.log | head -30 >&2
    echo "Tests fehlgeschlagen, Push abgebrochen. Vollständige Ausgabe: /tmp/focusflow-pre-push.log" >&2
    exit 1
fi
echo "FocusFlow: Tests bestanden."
